          "image_namespace": "ghcr.io/example/full-stack-web",
          "container_port": 3000,
          "container_memory": "256m",
          "container_cpus": 0.5,
          "pids_limit": 64,
          "route_prefix": "/",
          "slot_ips": {
            "blue": "172.30.50.31",
            "green": "172.30.50.32"
          },
          "health_path": "/health",
          "expected_health_text": "ok",
          "readiness_timeout_seconds": 120,
          "route_health_url": "http://127.0.0.1:18090/health"
        }
      },
