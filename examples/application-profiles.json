        "engine": "postgresql",
        "migration_adapter": "flyway",
        "backup_adapter": "verified-dump"
      },
      "migration_image_namespace": "ghcr.io/example/full-stack-migrator",
      "database_env_file": "/etc/roman-platform/sample-full-stack/database.env",
      "migration_database_env_file": "/etc/roman-platform/sample-full-stack/migration.env",
      "migration_database_username": "sample_full_stack_migrator",
      "writer_observer_database_env_file": "/etc/roman-platform/sample-full-stack/writer-observer.env",
      "allowed_database_urls": [
        "jdbc:postgresql://postgres.example.invalid:5432/sample_full_stack"
      ],
      "schema_migration": {
        "adapter": "flyway",
        "execution_role": "sample_full_stack_app",
        "max_pending": 32,
        "writer_usernames": [
          "sample_full_stack_app"
        ],
        "rollback_after_migration": "forward-only",
        "allow_initial_schema": false
      },
      "database_backup": {
        "adapter": "verified-dump",
        "env_file": "/etc/roman-platform/sample-full-stack/backup.env",
        "directory": "/srv/apps/sample-full-stack/backups",
        "timeout_seconds": 1800,
        "keep_last": 7
      },
      "secret_refs": [
        "/etc/roman-platform/sample-full-stack/runtime.env",
