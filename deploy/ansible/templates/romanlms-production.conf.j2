server {
    listen 127.0.0.1:8081;
    server_name romanlms.com;
    server_tokens off;
    access_log off;
    client_max_body_size 250m;
    client_body_timeout 300s;
    send_timeout 300s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Actuator health is intentionally allowlisted by the active release file;
    # every other management endpoint stays private to the host.
    location ^~ /lms/actuator/ {
        return 404;
    }

    include /etc/roman-platform/nginx/active-romanlms-production.conf;
}

# Private Control Plane integration path. The LMS service JWT remains required by
# the backend; this bridge additionally admits only the registered backend slots.
server {
    listen 172.30.74.1:18095;
    server_name _;
    server_tokens off;
    access_log off;

    allow 172.30.74.21;
    allow 172.30.74.22;
    deny all;

    location ^~ /lms/internal/platform/v1/ {
        limit_except GET POST PUT {
            deny all;
        }
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host romanlms.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 2s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    location / {
        return 404;
    }
}
