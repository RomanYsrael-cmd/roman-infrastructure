#!/usr/bin/python3
"""Create and privately verify the first SchedulEase production administrator."""
import argparse
import getpass
import http.client
import json
import os
import re
import subprocess
import sys
from http.cookies import SimpleCookie
from pathlib import Path

import bcrypt

APP_ID = "schedulease-production"
CONTAINER = "roman-platform-schedulease-production-db"
DATABASE = "schedulease_prod"
HOST = "schedulease.romanlms.com"
PORT = 18092
RESERVED = {"admin", "root", "system", "support", "schedulease", "test", "administrator", "superuser"}


def psql(script):
    result = subprocess.run(
        ["docker", "exec", "-i", CONTAINER, "psql", "-X", "-qAt", "-U", "postgres", "-d",
         DATABASE, "-v", "ON_ERROR_STOP=1", "-v", "VERBOSITY=terse"],
        input=script, text=True, capture_output=True, timeout=30,
    )
    if result.returncode:
        raise RuntimeError("The database rejected the owner bootstrap; review the bootstrap prerequisites.")
    return result.stdout.strip()


def create_owner(school, department, username, email, password):
    record = {
        "school": school,
        "department": department,
        "username": username,
        "email": email,
        "password_hash": bcrypt.hashpw(password.encode(), bcrypt.gensalt(rounds=12)).decode(),
    }
    payload = json.dumps(record).encode().hex()
    psql(f"""
BEGIN;
LOCK TABLE public.school, public.department, public.useraccount, public.user_role IN SHARE ROW EXCLUSIVE MODE;
DO $bootstrap$
DECLARE
    settings jsonb := convert_from(decode('{payload}', 'hex'), 'UTF8')::jsonb;
    new_school bigint;
    new_department bigint;
    new_user bigint;
    application_role bigint;
BEGIN
    IF current_database() <> '{DATABASE}' OR
       EXISTS (SELECT FROM public.school) OR EXISTS (SELECT FROM public.department) OR
       EXISTS (SELECT FROM public.useraccount) OR EXISTS (SELECT FROM public.user_role) THEN
        RAISE EXCEPTION 'Owner initialization requires the empty managed database';
    END IF;
    IF (SELECT count(*) FROM public.flyway_schema_history WHERE success) <> 12 OR
       NOT EXISTS (SELECT FROM public.flyway_schema_history WHERE version = '12' AND checksum = 620844546 AND success) OR
       EXISTS (SELECT FROM public.flyway_schema_history WHERE NOT success) THEN
        RAISE EXCEPTION 'Expected the verified fresh schema at V12';
    END IF;
    SELECT role_id INTO STRICT application_role FROM public.role
        WHERE code = 'PLATFORM_ADMINISTRATOR' AND system_role AND department_id IS NULL;
    INSERT INTO public.school(name) VALUES (settings->>'school') RETURNING school_id INTO new_school;
    INSERT INTO public.department(name, school_id)
        VALUES (settings->>'department', new_school) RETURNING department_id INTO new_department;
    INSERT INTO public.useraccount(username, email, password_hash, department_id, role, display_name, active)
        VALUES (settings->>'username', settings->>'email', settings->>'password_hash', new_department,
                'DEV', settings->>'username', true) RETURNING user_id INTO new_user;
    INSERT INTO public.user_role(user_id, role_id, department_id)
        VALUES (new_user, application_role, new_department);
    INSERT INTO public.user_audit_log(target_user_id, action, actor_username, detail)
        VALUES (new_user, 'INITIALIZE_OWNER', settings->>'username', 'Created through the private production bootstrap');
END;
$bootstrap$;
COMMIT;
""")


class PrivateSession:
    def __init__(self):
        self.cookies = {}

    def request(self, method, path, body=None, *, csrf=None, stream=False):
        headers = {"Host": HOST, "X-Forwarded-Proto": "https", "Origin": f"https://{HOST}"}
        if self.cookies:
            headers["Cookie"] = "; ".join(f"{name}={value}" for name, value in self.cookies.items())
        if body is not None:
            body = json.dumps(body)
            headers["Content-Type"] = "application/json"
        if csrf is not None:
            headers[csrf["headerName"]] = csrf["token"]
        if stream:
            headers["Accept"] = "text/event-stream"
        connection = http.client.HTTPConnection("127.0.0.1", PORT, timeout=10)
        try:
            connection.request(method, path, body, headers)
            response = connection.getresponse()
            cookies = SimpleCookie()
            for name, value in response.getheaders():
                if name.lower() == "set-cookie":
                    cookies.load(value)
            for name, value in cookies.items():
                if value["max-age"] == "0":
                    self.cookies.pop(name, None)
                else:
                    self.cookies[name] = value.value
            if stream and response.status == 200:
                lines = []
                for _ in range(8):
                    line = response.readline()
                    if not line or line.strip() == b"":
                        break
                    lines.append(line)
                raw = b"".join(lines)
            else:
                raw = response.read(64 * 1024)
            return response.status, raw, cookies, response.getheader("Content-Type", "")
        finally:
            connection.close()


def verify_ready():
    status, body, _, _ = PrivateSession().request("GET", "/actuator/health/readiness")
    if status != 200 or json.loads(body).get("status") != "UP":
        raise RuntimeError("Managed production readiness has not passed.")


def verify_owner(username, password):
    session = PrivateSession()
    status, body, cookies, _ = session.request("GET", "/api/auth/csrf")
    if status != 200 or not cookies.get("XSRF-TOKEN") or not cookies["XSRF-TOKEN"]["secure"]:
        raise RuntimeError("Forwarded HTTPS did not produce a secure CSRF cookie.")
    csrf = json.loads(body)
    login = {"username": username, "password": password}
    if session.request("POST", "/api/auth/login", login)[0] != 403:
        raise RuntimeError("Login did not reject a request without the CSRF header.")
    status, body, cookies, _ = session.request("POST", "/api/auth/login", login, csrf=csrf)
    session_cookie = cookies.get("SESSIONID")
    if status != 200 or json.loads(body).get("role") != "ROLE_PLATFORM_ADMINISTRATOR":
        raise RuntimeError("Private login did not return platform administrator authorization.")
    if not session_cookie or not session_cookie["secure"] or not session_cookie["httponly"] or session_cookie["samesite"].lower() != "strict":
        raise RuntimeError("The authentication cookie is missing required security attributes.")
    if session.request("GET", "/api/auth/me")[0] != 200 or session.request("GET", "/api/users")[0] != 200:
        raise RuntimeError("The owner could not access authenticated application endpoints.")
    status, body, _, mime = session.request("GET", "/api/stream", stream=True)
    if status != 200 or "text/event-stream" not in mime or b"event:heartbeat" not in body.replace(b"event: ", b"event:"):
        raise RuntimeError("The authenticated event stream did not deliver its heartbeat.")
    status, body, _, _ = session.request("GET", "/api/auth/csrf")
    if status != 200:
        raise RuntimeError("Could not get a CSRF token for logout.")
    status, _, cookies, _ = session.request("POST", "/api/auth/logout", csrf=json.loads(body))
    if status not in (200, 204) or not cookies.get("SESSIONID") or cookies["SESSIONID"]["max-age"] != "0":
        raise RuntimeError("Logout did not clear the authentication cookie.")
    if session.request("GET", "/api/auth/me")[0] not in (401, 403):
        raise RuntimeError("Authentication survived logout.")


def validated_config():
    registry = json.loads(Path("/etc/roman-platform/applications.json").read_bytes())
    app = registry["applications"][APP_ID]
    if (app["private_listener_port"] != PORT or app["routes"][0]["domain"] != HOST
            or app["schema_migration"]["allow_initial_schema"]
            or app["allowed_database_urls"] != [f"jdbc:postgresql://172.30.73.10:5432/{DATABASE}"]):
        raise RuntimeError("The strict production database and listener policy must be active.")
    state = json.loads(Path(app["state_file"]).read_bytes())
    if state["active"].get("schema_version") != "12":
        raise RuntimeError("The active production release has not verified schema V12.")
    verify_ready()


def name_argument(parser, name):
    parser.add_argument(f"--{name}", help=f"the owner's real {name} name")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    name_argument(parser, "school")
    name_argument(parser, "department")
    parser.add_argument("--verify", action="store_true", help="verify credentials for an existing owner")
    args = parser.parse_args()
    if os.geteuid() != 0 or not sys.stdin.isatty():
        raise RuntimeError("Run through the private administrator SSH session with a terminal.")
    if not args.verify and (
        not args.school or not args.department or len(args.school.strip()) > 160 or len(args.department.strip()) > 160
        or not args.school.strip() or not args.department.strip()
    ):
        parser.error("Specify the owner's real --school and --department names.")
    validated_config()
    if not args.verify and psql("SELECT count(*) FROM public.useraccount;") != "0":
        raise RuntimeError("The initial owner has already been created. Use --verify.")
    username = input("Owner username: ").strip()
    if not re.fullmatch(r"[A-Za-z0-9._-]{3,64}", username) or username.lower() in RESERVED:
        raise RuntimeError("Choose a non-reserved username of 3–64 letters, digits, dots, underscores or hyphens.")
    email = None if args.verify else input("Owner email: ").strip()
    if email is not None and (len(email) > 254 or not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email)):
        raise RuntimeError("Enter the owner's valid email address.")
    password = getpass.getpass("Owner password: ")
    if not args.verify:
        if not 18 <= len(password.encode()) <= 72 or password != getpass.getpass("Confirm password: "):
            raise RuntimeError("Passwords must match and be 18–72 UTF-8 bytes.")
        create_owner(args.school.strip(), args.department.strip(), username, email, password)
        print("The first administrator was created for the named institution and department.")
    verify_owner(username, password)
    print("Private owner login, permissions, CSRF, secure cookies, SSE and logout passed.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        sys.exit(str(error) if isinstance(error, RuntimeError) else "The owner command could not complete safely.")
